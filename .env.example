# ==============================================================================
# CRAZY CRUNCH — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local overrides or configure in Render / Vercel dashboard
# ==============================================================================

# Server Port
PORT=3001
NODE_ENV=production

# Security & Owner Sessions
ADMIN_TOKEN=your-random-cryptographic-session-secret-here

# Cloud Database (Optional: PostgreSQL / Supabase)
# If left empty, Crazy Crunch automatically uses the rock-solid persistent local JSON DB
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Cloud Image Storage (Optional: Supabase Storage / AWS S3 / Cloudinary)
# If left empty, uploaded product photos are securely persisted to public/uploads
# SUPABASE_URL=https://[PROJECT-ID].supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# SUPABASE_STORAGE_BUCKET=product-photos

# Meta WhatsApp Business Cloud API (Optional for automated server alerts)
# Note: Customer click-to-chat checkout works 100% out-of-the-box without these credentials!
# WHATSAPP_API_TOKEN=EAA...
# WHATSAPP_PHONE_NUMBER_ID=108...
# WHATSAPP_BUSINESS_ACCOUNT_ID=105...
